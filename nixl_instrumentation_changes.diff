+#!/usr/bin/env python3
+import argparse
+import datetime as dt
+import re
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Dict, List, Optional, Tuple
+
+
+HEADER_RE = re.compile(
+    r"^(?P<level>[A-Z]+)\s+"
+    r"(?P<mon>\d{2})-(?P<day>\d{2})\s+"
+    r"(?P<time>\d{2}:\d{2}:\d{2})\s+"
+    r"\[(?P<src>[^\]]+)\]\s+"
+    r"(?P<msg>.*)$"
+)
+
+KV_RE = re.compile(r"([A-Za-z0-9_]+)=([^\s]+)")
+
+
+@dataclass
+class StatsRecord:
+    kind: str
+    ts: dt.datetime
+    src: str
+    fields: Dict[str, str] = field(default_factory=dict)
+
+    def get_int(self, key: str) -> Optional[int]:
+        val = self.fields.get(key)
+        if val is None:
+            return None
+        try:
+            return int(float(val))
+        except Exception:
+            return None
+
+
+def parse_ts(year: int, mon: str, day: str, hhmmss: str) -> dt.datetime:
+    hh, mm, ss = hhmmss.split(":")
+    return dt.datetime(year, int(mon), int(day), int(hh), int(mm), int(ss))
+
+
+def parse_records(log_path: Path, year: int) -> Dict[str, List[StatsRecord]]:
+    target_kinds = {
+        "nixl_decode_gate_stats",
+        "nixl_trans_ret_stats",
+        "nixl_decode_trans_stats",
+        "nixl_up_status_stats",
+        "nixl_prefill_trans_stats",
+    }
+
+    out: Dict[str, List[StatsRecord]] = {k: [] for k in target_kinds}
+    current: Optional[StatsRecord] = None
+
+    with log_path.open("r", encoding="utf-8", errors="ignore") as f:
+        for raw in f:
+            line = raw.rstrip("\n")
+            m = HEADER_RE.match(line)
+            if not m:
+                continue
+
+            ts = parse_ts(year, m.group("mon"), m.group("day"), m.group("time"))
+            src = m.group("src")
+            msg = m.group("msg").strip()
+
+            matched_kind: Optional[str] = None
+            for kind in target_kinds:
+                if msg == kind or msg.startswith(kind + " "):
+                    matched_kind = kind
+                    break
+
+            if matched_kind is not None:
+                if current is not None:
+                    out[current.kind].append(current)
+
+                current = StatsRecord(kind=matched_kind, ts=ts, src=src, fields={})
+
+                # Some logs keep all fields on the same line as the stats kind.
+                rest = msg[len(matched_kind) :].strip()
+                if rest:
+                    for k, v in KV_RE.findall(rest):
+                        current.fields[k] = v
+                continue
+
+            if current is None:
+                continue
+
+            if ts != current.ts or src != current.src:
+                out[current.kind].append(current)
+                current = None
+                continue
+
+            for k, v in KV_RE.findall(msg):
+                current.fields[k] = v
+
+    if current is not None:
+        out[current.kind].append(current)
+
+    return out
+
+
+def nearest_record(records: List[StatsRecord], ts: dt.datetime, max_gap_s: int) -> Optional[StatsRecord]:
+    if not records:
+        return None
+    best: Optional[Tuple[int, StatsRecord]] = None
+    for rec in records:
+        gap = abs(int((rec.ts - ts).total_seconds()))
+        if gap <= max_gap_s and (best is None or gap < best[0]):
+            best = (gap, rec)
+    return None if best is None else best[1]
+
+
+def diagnose(
+    gate: Optional[StatsRecord],
+    ret: Optional[StatsRecord],
+    trans: Optional[StatsRecord],
+    up: Optional[StatsRecord],
+    prefill: Optional[StatsRecord],
+) -> str:
+    if gate is None:
+        return "no_gate_stats"
+
+    gc = gate.get_int("gate_continue_w") or 0
+    gp = gate.get_int("gate_pass_w") or 0
+
+    if gc > 0 and gp == 0:
+        if ret is not None:
+            ret_seen = ret.get_int("ret_seen_w") or 0
+            if ret_seen == 0:
+                return "gate_all_blocked_and_no_ret_flow"
+            if ret_seen < 10:
+                return "gate_blocked_ret_flow_very_low"
+
+        if trans is not None:
+            peer_recv = trans.get_int("peer_task_recv_w") or 0
+            dispatch = trans.get_int("dispatch_task_w") or 0
+            waiting = trans.get_int("waiting_dict_len") or 0
+            if peer_recv == 0 and waiting > 0:
+                if prefill is not None:
+                    send_ok = prefill.get_int("send_readtask_ok_w") or 0
+                    send_fail = prefill.get_int("send_readtask_fail_w") or 0
+                    pre_waiting = prefill.get_int("waiting_dict_len") or 0
+                    if send_ok == 0 and send_fail > 0:
+                        return "prefill_send_readtask_failed"
+                    if send_ok == 0 and pre_waiting > 0:
+                        return "prefill_readtask_not_sent"
+                return "decode_waiting_peer_tasks"
+            if dispatch == 0 and waiting > 0:
+                return "decode_dispatch_stalled"
+
+        if up is not None:
+            send_fail = up.get_int("send_fail_w") or 0
+            send_slow = up.get_int("send_ms_slow_w") or 0
+            if send_fail > 0:
+                return "up_status_send_failed"
+            if send_slow > 0:
+                return "up_status_send_slow"
+
+        return "gate_blocked_unknown"
+
+    return "not_fully_blocked"
+
+
+def diagnose_prefill(
+    prefill: Optional[StatsRecord],
+    ret: Optional[StatsRecord],
+    trans: Optional[StatsRecord],
+    up: Optional[StatsRecord],
+) -> str:
+    if prefill is None:
+        return "no_prefill_stats"
+
+    recv_task = prefill.get_int("recv_task_w") or 0
+    send_ok = prefill.get_int("send_readtask_ok_w") or 0
+    send_fail = prefill.get_int("send_readtask_fail_w") or 0
+    ret_recv = prefill.get_int("ret_recv_w") or 0
+    waiting = prefill.get_int("waiting_dict_len") or 0
+    timeout_update = prefill.get_int("timeout_update_w") or 0
+
+    if send_fail > 0:
+        return "prefill_send_readtask_failed"
+    if timeout_update > 0:
+        return "prefill_timeout_update"
+    if recv_task > 0 and send_ok == 0 and send_fail == 0:
+        return "prefill_readtask_not_sent_yet"
+    if send_ok > 0 and ret_recv == 0 and waiting > 0:
+        return "prefill_waiting_decode_ret"
+
+    if ret is not None:
+        ret_seen = ret.get_int("ret_seen_w") or 0
+        if send_ok > 0 and ret_seen == 0:
+            return "prefill_readtask_sent_but_no_ret"
+
+    if trans is not None:
+        peer_recv = trans.get_int("peer_task_recv_w") or 0
+        if send_ok > 0 and peer_recv == 0:
+            return "prefill_sent_decode_peer_recv_low"
+
+    if up is not None:
+        send_fail_up = up.get_int("send_fail_w") or 0
+        if send_fail_up > 0:
+            return "up_status_send_failed"
+
+    return "prefill_flowing"
+
+
+def print_aligned(records: Dict[str, List[StatsRecord]], max_gap_s: int, limit: int) -> None:
+    gate_list = sorted(records["nixl_decode_gate_stats"], key=lambda r: r.ts)
+    ret_list = sorted(records["nixl_trans_ret_stats"], key=lambda r: r.ts)
+    trans_list = sorted(records["nixl_decode_trans_stats"], key=lambda r: r.ts)
+    up_list = sorted(records["nixl_up_status_stats"], key=lambda r: r.ts)
+    prefill_list = sorted(records["nixl_prefill_trans_stats"], key=lambda r: r.ts)
+
+    if gate_list:
+        rows = gate_list[-limit:] if limit > 0 else gate_list
+        print(
+            "ts | gate_continue_w | gate_pass_w | ret_seen_w | trans_peer_recv_w | trans_waiting_len | "
+            "prefill_send_readtask_ok_w | prefill_ret_recv_w | prefill_waiting_len | up_send_fail_w | diagnosis"
+        )
+        print("-" * 200)
+
+        for gate in rows:
+            ret = nearest_record(ret_list, gate.ts, max_gap_s)
+            trans = nearest_record(trans_list, gate.ts, max_gap_s)
+            up = nearest_record(up_list, gate.ts, max_gap_s)
+            prefill = nearest_record(prefill_list, gate.ts, max_gap_s)
+
+            diag = diagnose(gate, ret, trans, up, prefill)
+
+            gc = gate.get_int("gate_continue_w")
+            gp = gate.get_int("gate_pass_w")
+            rs = None if ret is None else ret.get_int("ret_seen_w")
+            pr = None if trans is None else trans.get_int("peer_task_recv_w")
+            wl = None if trans is None else trans.get_int("waiting_dict_len")
+            ps = None if prefill is None else prefill.get_int("send_readtask_ok_w")
+            prr = None if prefill is None else prefill.get_int("ret_recv_w")
+            pwl = None if prefill is None else prefill.get_int("waiting_dict_len")
+            sf = None if up is None else up.get_int("send_fail_w")
+
+            print(
+                f"{gate.ts.strftime('%m-%d %H:%M:%S')} | "
+                f"{gc} | {gp} | {rs} | {pr} | {wl} | {ps} | {prr} | {pwl} | {sf} | {diag}"
+            )
+        return
+
+    if prefill_list:
+        rows = prefill_list[-limit:] if limit > 0 else prefill_list
+        print(
+            "ts | prefill_recv_task_w | prefill_send_readtask_ok_w | prefill_send_readtask_fail_w | "
+            "prefill_ret_recv_w | prefill_waiting_len | ret_seen_w | trans_peer_recv_w | diagnosis"
+        )
+        print("-" * 180)
+
+        for prefill in rows:
+            ret = nearest_record(ret_list, prefill.ts, max_gap_s)
+            trans = nearest_record(trans_list, prefill.ts, max_gap_s)
+            up = nearest_record(up_list, prefill.ts, max_gap_s)
+
+            diag = diagnose_prefill(prefill, ret, trans, up)
+
+            rt = prefill.get_int("recv_task_w")
+            so = prefill.get_int("send_readtask_ok_w")
+            sf = prefill.get_int("send_readtask_fail_w")
+            rr = prefill.get_int("ret_recv_w")
+            wl = prefill.get_int("waiting_dict_len")
+            rs = None if ret is None else ret.get_int("ret_seen_w")
+            pr = None if trans is None else trans.get_int("peer_task_recv_w")
+
+            print(
+                f"{prefill.ts.strftime('%m-%d %H:%M:%S')} | "
+                f"{rt} | {so} | {sf} | {rr} | {wl} | {rs} | {pr} | {diag}"
+            )
+        return
+
+    print("No stats records found for: nixl_decode_gate_stats / nixl_prefill_trans_stats.")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description="Align NIXL PD stats windows and print bottleneck diagnosis.")
+    parser.add_argument("--log", required=True, help="Path to log file, e.g. _/server_log_p2d2/d23.log")
+    parser.add_argument("--year", type=int, default=dt.datetime.now().year, help="Year used to parse timestamps")
+    parser.add_argument("--max-gap", type=int, default=3, help="Max seconds for nearest-window alignment")
+    parser.add_argument("--limit", type=int, default=20, help="Print last N gate windows (0 for all)")
+    args = parser.parse_args()
+
+    log_path = Path(args.log)
+    if not log_path.exists():
+        raise SystemExit(f"Log file not found: {log_path}")
+
+    records = parse_records(log_path, year=args.year)
+    print_aligned(records, max_gap_s=args.max_gap, limit=args.limit)
+
+
+if __name__ == "__main__":
+    main()
